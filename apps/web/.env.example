# Copy to .env.local and fill in. Never commit .env.local.

# Neon connection string (pooled). Neon dashboard -> Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Only when self-hosting behind a proxy, or serving a production build on
# localhost. Vercel deployments infer the host and do not need this.
# AUTH_TRUST_HOST="true"

# The single operator. Only this address can sign in.
WERFT_USER_EMAIL="you@example.com"

# Generate with: pnpm hash-password '<your password>'
WERFT_PASSWORD_HASH=""

# Only present when the app was scaffolded with --with-s3. Werft mints these:
# a bucket and a bucket-scoped IAM user, so this key can touch this bucket and
# nothing else. Never the AWS admin key.
# S3_BUCKET=""
# AWS_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Model access for the app itself, through the Kompass gateway. Set on every
# scaffolded app, whether or not it uses AI — an app that never calls a model
# simply never reads them. src/kompass.ts is the only thing that should.
KOMPASS_BASE_URL="https://kompass.vinoth4v.workers.dev"
KOMPASS_TOKEN=""

# Optional model pins, per station. All of them are optional and all of them
# default to a Kompass lane alias, which is the supported state — the gateway
# picks the model and handles quota, and the app keeps working when the roster
# changes. Set one only where the exact model is pedagogy rather than taste.
# Format: kompass:<provider>/<model>
#
# The deliberately weak model behind Die Jagd. Weak-and-confident is the
# desired behaviour: this station teaches that a model is wrong while sounding
# certain, and a strong model here silently deletes the core week.
# SEGEL_PIN_JAGD="kompass:openai/gpt-oss-120b"
#
# Both halves of the Prompt-Labor. Must be one model or the comparison measures
# the models instead of the prompts.
# SEGEL_PIN_LABOR="kompass:deepseek/deepseek-v3.2"
#
# The zoo's line-up, comma-separated, three of them. Left unset, the zoo uses
# three different lanes and reports whatever actually served each column.
# SEGEL_PIN_ZOO="kompass:google/gemini-3.6-flash,kompass:z-ai/glm-5.2,kompass:minimax/minimax-m3"
#
# SEGEL_PIN_TALK=""
# SEGEL_PIN_WERKSTATT=""
# SEGEL_PIN_GRADE=""
